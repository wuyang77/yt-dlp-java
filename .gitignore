# =====================================================
# Git 忽略文件配置
# =====================================================

# --- IDE 配置 ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.codebuddy/

# --- Maven 构建产物 ---
target/
*.jar
!src/main/resources/*.jar

# --- Vue frontend build artifacts ---
frontend/node_modules/
frontend-dist/

# --- 二进制依赖（体积大，不纳入版本控制） ---
src/main/resources/*.exe
src/main/resources/*.dll

# --- 运行时产物 ---
*.log
*.cfg
downloads/
/release/

# --- YouTube 登录凭证（禁止提交） ---
src/main/resources/cookies.txt

# --- 操作系统生成文件 ---
.DS_Store
Thumbs.db
desktop.ini

# --- Spring Boot 本地配置（可覆盖） ---
application-local.yml
